# --- the model ---------------------------------------------------------------
# Unset is a working install: the agent routes say so, everything else runs.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com
STEWARD_AGENT_MODEL=gpt-5

# --- storage -----------------------------------------------------------------
STEWARD_DB=steward.sqlite3

# --- the sponsor dashboard ---------------------------------------------------
# `steward serve --person <sponsor-id>`, read-only, one household per process.
# The port is settable; the address is not. It binds 127.0.0.1 always, because
# the page has no authentication — see config.web_port for why that is a
# deliberate omission rather than a missing feature.
# STEWARD_WEB_PORT=8787

# --- pay-warden (policy decisions over MCP) ----------------------------------
# Every spend goes through it. Absent means no purchase can be made.
PAY_WARDEN_COMMAND=uv
PAY_WARDEN_ARGS=run --project ../pay-warden python -m pay_warden.server
# It resolves its policy and audit database relative to its own directory.
PAY_WARDEN_CWD=../pay-warden
# pay-warden's own settings. Anything named PAY_WARDEN_* or PRAVA_* is forwarded
# into the subprocess; nothing else is (our OpenAI key never leaves this process).
# A spender must appear in this policy under `steward:person_<id>` or every
# purchase is denied with `unknown-agent` — enrolling them in steward is not
# enough, which is fail-closed and correct.
PAY_WARDEN_POLICY=../pay-warden/policies/default.yaml

# --- local extraction (Ollama) -----------------------------------------------
# The one model that sees raw text, which is only acceptable while the request
# cannot leave this machine. A non-loopback host is refused unless you say so
# explicitly, in which case unredacted personal data will travel to it.
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
STEWARD_LOCAL_LLM_ALLOW_REMOTE=

# --- Google (read-only calendar and mail) ------------------------------------
# steward runs no consent flow: obtain a token yourself and paste it here. Only
# *.readonly scopes are used, and nothing here sends, deletes or writes.
# Unverified against a live account — see integrations/google.py.
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Linq (messaging surface; sandbox expires quickly) -----------------------
LINQ_API_TOKEN=
LINQ_API_BASE=https://api.linqapp.com/api/partner/v3
LINQ_FROM_NUMBER=
# Messages are described, not sent, until this is explicitly on. A text reaches
# a real person and cannot be recalled.
STEWARD_LINQ_LIVE=
